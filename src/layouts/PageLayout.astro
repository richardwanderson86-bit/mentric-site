---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />

  <!-- Sticky CTA - appears after scrolling past the hero -->
  <div
    id="sticky-cta"
    class="fixed bottom-6 right-6 z-40 opacity-0 translate-y-4 pointer-events-none transition-all duration-300"
  >
    <a
      href="/contact"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-primary text-white text-sm font-medium shadow-glow-lg hover:scale-105 transition-transform duration-200"
    >
      Book a Demo
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>

  <script>
    const stickyCta = document.getElementById("sticky-cta");
    if (stickyCta) {
      // Don't show on the contact page itself
      const isContactPage = window.location.pathname.startsWith("/contact");
      if (!isContactPage) {
        window.addEventListener("scroll", () => {
          if (window.scrollY > 600) {
            stickyCta.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
            stickyCta.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
          } else {
            stickyCta.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
            stickyCta.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
          }
        }, { passive: true });
      }
    }
  </script>
</BaseLayout>
