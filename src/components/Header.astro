---
const navItems = [
  { label: "Features", href: "/features" },
  { label: "For Practices", href: "/for-practices" },
  { label: "For Coaches", href: "/for-coaches" },
  { label: "For Organisations", href: "/for-organisations" },
  { label: "About", href: "/about" },
];

const resourcesSubItems = [
  { label: "Blog", href: "/resources/blog", description: "Articles on coaching practice and measurement" },
  { label: "Podcast", href: "/resources/podcast", description: "Conversations with the people proving coaching works" },
  { label: "Briefings", href: "/briefings/proving-the-value-of-coaching", description: "Free email courses with practical templates" },
];

const currentPath = Astro.url.pathname;
const isResourcesActive = currentPath.startsWith("/resources") || currentPath.startsWith("/briefings");
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-border transition-shadow duration-300"
>
  <div class="section-container">
    <nav class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0" aria-label="Mentric home">
        <img
          src="/logo-full.webp"
          alt="Mentric"
          class="h-8 w-auto"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden lg:flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200",
                  currentPath === item.href || currentPath.startsWith(item.href + "/")
                    ? "text-primary bg-primary-light"
                    : "text-foreground/80 hover:text-primary hover:bg-primary-light/50",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <!-- Resources dropdown -->
        <li class="relative" id="resources-dropdown">
          <a
            href="/resources"
            class:list={[
              "px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 inline-flex items-center gap-1",
              isResourcesActive
                ? "text-primary bg-primary-light"
                : "text-foreground/80 hover:text-primary hover:bg-primary-light/50",
            ]}
          >
            Resources
            <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200" id="resources-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
          <div
            id="resources-menu"
            class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible transition-all duration-200"
          >
            <div class="w-72 rounded-xl border border-border bg-white shadow-lg p-2">
              {resourcesSubItems.map((sub) => (
                <a
                  href={sub.href}
                  class:list={[
                    "block px-4 py-3 rounded-lg transition-colors duration-200",
                    currentPath.startsWith(sub.href)
                      ? "bg-primary-light"
                      : "hover:bg-primary-light/50",
                  ]}
                >
                  <span class:list={[
                    "block text-sm font-medium",
                    currentPath.startsWith(sub.href) ? "text-primary" : "text-ink",
                  ]}>
                    {sub.label}
                  </span>
                  <span class="block text-xs text-muted mt-0.5">{sub.description}</span>
                </a>
              ))}
            </div>
          </div>
        </li>
      </ul>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="https://app.mentriccoaching.com/login" class="btn-secondary text-sm px-4 py-2"> Log In </a>
        <a href="/demo" class="btn-primary text-sm"> Book a Demo </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden relative w-10 h-10 flex items-center justify-center rounded-lg hover:bg-primary-light/50 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon-open"
          class="w-5 h-5 text-foreground"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="w-5 h-5 text-foreground hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-border bg-white"
  >
    <div class="section-container py-4 space-y-1">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "block px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-200",
              currentPath === item.href || currentPath.startsWith(item.href + "/")
                ? "text-primary bg-primary-light"
                : "text-foreground/80 hover:text-primary hover:bg-primary-light/50",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <!-- Mobile Resources section -->
      <div class="pt-1">
        <span class="block px-4 py-2 text-xs font-semibold uppercase tracking-widest text-muted/60">Resources</span>
        {resourcesSubItems.map((sub) => (
          <a
            href={sub.href}
            class:list={[
              "block px-4 py-3 rounded-lg text-sm font-medium transition-colors duration-200 ml-2",
              currentPath.startsWith(sub.href)
                ? "text-primary bg-primary-light"
                : "text-foreground/80 hover:text-primary hover:bg-primary-light/50",
            ]}
          >
            {sub.label}
          </a>
        ))}
      </div>
      <hr class="my-3 border-border" />
      <div class="flex flex-col gap-2 px-4 pb-2">
        <a href="https://app.mentriccoaching.com/login" class="btn-secondary text-sm text-center"> Log In </a>
        <a href="/demo" class="btn-primary text-sm text-center">
          Book a Demo
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  if (toggle && menu && iconOpen && iconClose) {
    toggle.addEventListener("click", () => {
      const isOpen = !menu.classList.contains("hidden");

      menu.classList.toggle("hidden");
      iconOpen.classList.toggle("hidden");
      iconClose.classList.toggle("hidden");
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });
  }

  // Resources dropdown (desktop)
  const dropdown = document.getElementById("resources-dropdown");
  const dropdownMenu = document.getElementById("resources-menu");
  const chevron = document.getElementById("resources-chevron");

  if (dropdown && dropdownMenu && chevron) {
    dropdown.addEventListener("mouseenter", () => {
      dropdownMenu.classList.remove("opacity-0", "invisible");
      dropdownMenu.classList.add("opacity-100", "visible");
      chevron.classList.add("rotate-180");
    });

    dropdown.addEventListener("mouseleave", () => {
      dropdownMenu.classList.add("opacity-0", "invisible");
      dropdownMenu.classList.remove("opacity-100", "visible");
      chevron.classList.remove("rotate-180");
    });
  }

  // Add shadow on scroll
  const header = document.getElementById("site-header");
  if (header) {
    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY > 8) {
          header.classList.add("shadow-editorial");
        } else {
          header.classList.remove("shadow-editorial");
        }
      },
      { passive: true }
    );
  }
</script>
