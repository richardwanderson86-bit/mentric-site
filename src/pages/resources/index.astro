---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout title="Resources | Mentric Coaching Platform" description="Blogs, podcasts, and briefings for coaches and coaching organisations. Insights, ideas, and inspiration from the Mentric team.">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-glow-gradient">
    <div class="section-container py-10 md:py-14 text-center">
      <p class="category-label mb-4">Resources</p>
      <h1 class="max-w-4xl mx-auto">
        Insights, ideas, and
        <span class="text-primary">inspiration</span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg md:text-xl">
        Blogs, podcasts, and briefings for coaches and organisations who believe
        in the power of structured, measurable coaching.
      </p>
    </div>
  </section>

  <!-- Resource Cards -->
  <section class="bg-background">
    <div class="section-container py-10 md:py-14">
      <div class="grid gap-8 md:grid-cols-3">

        <!-- Blog -->
        <a href="/resources/blog" class="group card-editorial flex flex-col overflow-hidden hover:-translate-y-1 transition-transform duration-300">
          <div class="h-1.5 w-full bg-gradient-to-r from-primary to-primary/60" />
          <div class="flex flex-col flex-1 p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
              </svg>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-ink group-hover:text-primary transition-colors duration-200">Blog</h2>
            <p class="mt-3 text-sm text-muted leading-relaxed flex-1">
              Articles on coaching practice, measurement, platforms and scaling your impact.
            </p>
            <span class="mt-5 inline-flex items-center text-sm font-semibold text-primary group-hover:gap-2 gap-1 transition-all duration-200">
              Read articles
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
            </span>
          </div>
        </a>

        <!-- Podcast -->
        <a href="/resources/podcast" class="group card-editorial flex flex-col overflow-hidden hover:-translate-y-1 transition-transform duration-300">
          <div class="h-1.5 w-full" style="background: linear-gradient(to right, #2d0a2e, #d52d91, #f0a030);" />
          <div class="flex flex-col flex-1 p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
              </svg>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-ink group-hover:text-primary transition-colors duration-200">
              Podcast
            </h2>
            <p class="mt-1 text-sm italic text-muted/70">Coaching Returns</p>
            <p class="mt-3 text-sm text-muted leading-relaxed flex-1">
              Conversations with the people who commission, run and prove coaching.
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
              </span>
              Coming soon
            </span>
          </div>
        </a>

        <!-- Briefings -->
        <a href="/briefings/proving-the-value-of-coaching" class="group card-editorial flex flex-col overflow-hidden hover:-translate-y-1 transition-transform duration-300">
          <div class="h-1.5 w-full bg-gradient-to-r from-primary-dark to-primary" />
          <div class="flex flex-col flex-1 p-6 md:p-8">
            <div class="w-12 h-12 rounded-full bg-glow/10 flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-glow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <h2 class="text-xl md:text-2xl font-bold text-ink group-hover:text-primary transition-colors duration-200">Briefings</h2>
            <p class="mt-3 text-sm text-muted leading-relaxed flex-1">
              Free email courses with practical templates you can use straight away.
            </p>
            <span class="mt-5 inline-flex items-center text-sm font-semibold text-primary group-hover:gap-2 gap-1 transition-all duration-200">
              Get the briefing
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
            </span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-plum-gradient">
    <div class="section-container py-10 md:py-14 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-200 mb-4">Contribute</p>
      <h2 class="text-white max-w-3xl mx-auto">Want to contribute?</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-primary-200">
        We're always looking for coaching professionals who want to share their
        expertise. If you have an idea for a blog post, podcast episode, or
        briefing, we'd love to hear from you.
      </p>
      <div class="mt-10">
        <a href="/contact" class="btn-primary-lg bg-white text-primary hover:bg-primary-50 hover:shadow-glow-lg">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

</PageLayout>
