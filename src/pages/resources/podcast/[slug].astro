---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const episodes = await getCollection('podcast', ({ data }) => !data.draft);
  return episodes.map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await episode.render();

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: episode.data.title,
  description: episode.data.description,
  datePublished: new Date(episode.data.date).toISOString(),
  ...(episode.data.episodeNumber && { episodeNumber: episode.data.episodeNumber }),
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'Coaching Returns',
    url: 'https://www.mentriccoaching.com/resources/podcast',
  },
};
---

<PageLayout
  title={`${episode.data.title} | Coaching Returns`}
  description={episode.data.description}
  ogImage="/images/coaching-returns-cover.png"
  jsonLd={jsonLd}
>

  <article class="bg-white">
    <div class="max-w-3xl mx-auto px-6 md:px-8 py-10 md:py-14">

      <!-- Back link -->
      <a href="/resources/podcast" class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-primary transition-colors mb-10">
        <span>&larr;</span>
        Back to Coaching Returns
      </a>

      <!-- Episode meta -->
      <div class="flex items-center gap-4 mb-6">
        <span class="inline-block px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-widest bg-accent/20 text-accent-dark">
          Podcast
        </span>
        {episode.data.episodeNumber && (
          <span class="text-xs text-muted font-semibold uppercase tracking-wide">
            Episode {episode.data.episodeNumber}
          </span>
        )}
        <span class="text-xs text-muted font-medium uppercase tracking-wide">
          {formatDate(episode.data.date)}
        </span>
        {episode.data.duration && (
          <span class="text-xs text-muted/60">{episode.data.duration}</span>
        )}
      </div>

      <!-- Title -->
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-ink leading-tight mb-4">
        {episode.data.title}
      </h1>

      <!-- Guest -->
      {episode.data.guest && (
        <p class="text-muted text-base mb-10">
          With {episode.data.guest}
        </p>
      )}

      <!-- Divider -->
      <hr class="border-border mb-10" />

      <!-- Listen links -->
      {(episode.data.spotifyUrl || episode.data.appleUrl || episode.data.youtubeUrl) && (
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <span class="text-sm font-medium text-muted mr-1">Listen on:</span>
          {episode.data.spotifyUrl && (
            <a href={episode.data.spotifyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border text-sm font-medium text-ink hover:border-primary hover:text-primary transition-colors">
              Spotify
            </a>
          )}
          {episode.data.appleUrl && (
            <a href={episode.data.appleUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border text-sm font-medium text-ink hover:border-primary hover:text-primary transition-colors">
              Apple Podcasts
            </a>
          )}
          {episode.data.youtubeUrl && (
            <a href={episode.data.youtubeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-border text-sm font-medium text-ink hover:border-primary hover:text-primary transition-colors">
              YouTube
            </a>
          )}
        </div>
      )}

      <!-- Content / Show Notes -->
      <div class="prose prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-ink prose-headings:tracking-tight
        prose-p:text-foreground/80 prose-p:leading-relaxed
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-strong:text-ink
        prose-li:text-foreground/80
        prose-blockquote:border-primary prose-blockquote:text-muted
      ">
        <Content />
      </div>

      <!-- Footer -->
      <hr class="border-border mt-16 mb-8" />
      <a href="/resources/podcast" class="inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-primary transition-colors">
        <span>&larr;</span>
        Back to Coaching Returns
      </a>

    </div>
  </article>

</PageLayout>
