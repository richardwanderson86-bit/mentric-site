---
import PageLayout from '@layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

// Get all podcast episodes, sorted by date (newest first)
const episodes = (await getCollection('podcast', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'Coaching Returns',
  description: 'Conversations with the people who commission, run and prove coaching.',
  url: 'https://www.mentriccoaching.com/resources/podcast',
  image: 'https://www.mentriccoaching.com/images/coaching-returns-cover.png',
};
---

<PageLayout
  title="Coaching Returns Podcast | Mentric"
  description="Conversations with the people who commission, run and prove coaching. A podcast by Mentric."
  ogImage="/images/coaching-returns-cover.png"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #2d0a2e 0%, #3d1341 40%, #2d0a2e 100%);">
    <div class="section-container py-14 md:py-20">
      <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
        <!-- Cover Art -->
        <div class="flex-shrink-0">
          <img
            src="/images/coaching-returns-cover.png"
            alt="Coaching Returns podcast cover"
            class="w-64 md:w-80 rounded-2xl shadow-2xl"
            loading="eager"
          />
        </div>
        <!-- Info -->
        <div class="text-center md:text-left">
          <p class="text-xs font-semibold uppercase tracking-widest text-pink-300/80 mb-4">Podcast</p>
          <h1 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
            Coaching
            <span class="block italic text-amber-400" style="font-family: Georgia, 'Times New Roman', serif;">Returns</span>
          </h1>
          <p class="mt-6 text-lg md:text-xl text-white/70 max-w-lg leading-relaxed">
            Conversations with the people who commission, run and prove coaching.
          </p>

          <!-- Coming Soon Badge -->
          <div class="mt-8 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 text-white text-sm font-medium">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-amber-400"></span>
            </span>
            Coming Soon
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Podcast -->
  <section class="bg-background">
    <div class="section-container py-14 md:py-20">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-ink">What to expect</h2>
        <p class="mt-6 text-lg text-muted leading-relaxed">
          Coaching Returns explores the real impact of coaching through candid conversations
          with the leaders, practitioners and organisations making it work. Each episode digs
          into what good coaching looks like, how to measure its value, and why it matters
          more than ever.
        </p>
        <p class="mt-4 text-lg text-muted leading-relaxed">
          Expect honest voices from coaches, buyers and coachees. Real stories about what
          worked, what didn't, and how organisations are getting better at proving coaching
          delivers.
        </p>
      </div>
    </div>
  </section>

  <!-- Episodes -->
  <section class="bg-white">
    <div class="section-container py-14 md:py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-ink text-center mb-10">Episodes</h2>

        {episodes.length > 0 ? (
          <div class="space-y-6">
            {episodes.map((episode) => (
              <a
                href={`/resources/podcast/${episode.slug}`}
                class="group block card-editorial p-6 md:p-8 hover:-translate-y-0.5 transition-all duration-300"
              >
                <div class="flex items-start gap-5">
                  {episode.data.episodeNumber && (
                    <div class="hidden sm:flex flex-shrink-0 w-12 h-12 rounded-full bg-primary/10 items-center justify-center">
                      <span class="text-sm font-bold text-primary">{episode.data.episodeNumber}</span>
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-2">
                      {episode.data.episodeNumber && (
                        <span class="sm:hidden text-xs font-semibold text-primary uppercase">
                          Ep. {episode.data.episodeNumber}
                        </span>
                      )}
                      <span class="text-xs text-muted font-medium uppercase tracking-wide">
                        {formatDate(episode.data.date)}
                      </span>
                      {episode.data.duration && (
                        <span class="text-xs text-muted/60">{episode.data.duration}</span>
                      )}
                    </div>
                    <h3 class="text-lg font-semibold text-ink group-hover:text-primary transition-colors duration-200 leading-snug">
                      {episode.data.title}
                    </h3>
                    <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-2">
                      {episode.data.description}
                    </p>
                  </div>
                  <div class="hidden sm:flex flex-shrink-0 w-10 h-10 rounded-full bg-primary/10 items-center justify-center group-hover:bg-primary group-hover:text-white transition-colors duration-200">
                    <svg class="w-4 h-4 text-primary group-hover:text-white transition-colors duration-200" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5.14v14l11-7-11-7z" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <p class="text-lg font-medium text-ink mb-2">Episodes dropping soon</p>
            <p class="text-muted">
              We're recording our first conversations now. Check back shortly.
            </p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-plum-gradient">
    <div class="section-container py-10 md:py-14 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary-200 mb-4">Be a guest</p>
      <h2 class="text-white max-w-3xl mx-auto">Got a story to tell?</h2>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-primary-200">
        We're looking for coaches, L&D leaders and organisations with
        real stories about the impact of coaching. If that's you, we'd love to chat.
      </p>
      <div class="mt-10">
        <a href="/contact" class="btn-primary-lg bg-white text-primary hover:bg-primary-50 hover:shadow-glow-lg">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

</PageLayout>
