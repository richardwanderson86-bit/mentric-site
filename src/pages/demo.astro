---
import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout title="Book a Conversation | Mentric" description="Book a personalised walkthrough of the Mentric platform. See how Mentric can bring structure, your brand, and sponsor-ready evidence to your coaching practice.">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-hero-animated">
    <div class="absolute top-16 left-[8%] w-56 h-56 rounded-full bg-primary/[0.03] blur-3xl animate-float"></div>
    <div class="section-container relative py-8 md:py-12 text-center">
      <p class="category-label mb-4">Book a Demo</p>
      <h1 class="max-w-3xl mx-auto">
        See Mentric <span class="text-primary">in action</span>
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg md:text-xl">
        Book a personalised walkthrough and discover how Mentric can bring
        structure, your brand, and sponsor-ready evidence to your coaching.
      </p>
    </div>
  </section>

  <!-- Two-column layout -->
  <section class="py-8 md:py-12">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14">

        <!-- Left column - Demo Form -->
        <div class="lg:col-span-3" data-reveal>
          <form
            action="https://formspree.io/f/xvzzorrg"
            method="POST"
            class="space-y-6"
          >
            <!-- Hidden field to identify demo requests -->
            <input type="hidden" name="_subject" value="Demo Request from Mentric Website" />

            <!-- Name row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-ink mb-2">
                  First name <span class="text-primary">*</span>
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  required
                  class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/50
                    transition-all duration-200
                    focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
                  placeholder="Jane"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-ink mb-2">
                  Last name <span class="text-primary">*</span>
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  required
                  class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/50
                    transition-all duration-200
                    focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
                  placeholder="Smith"
                />
              </div>
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-2">
                Work email <span class="text-primary">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/50
                  transition-all duration-200
                  focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
                placeholder="jane@example.com"
              />
            </div>

            <!-- Organisation -->
            <div>
              <label for="organisation" class="block text-sm font-medium text-ink mb-2">
                Organisation
              </label>
              <input
                type="text"
                id="organisation"
                name="organisation"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/50
                  transition-all duration-200
                  focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
                placeholder="Your company or organisation name"
              />
            </div>

            <!-- Role -->
            <div>
              <label for="role" class="block text-sm font-medium text-ink mb-2">
                I am a...
              </label>
              <select
                id="role"
                name="role"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink
                  transition-all duration-200 appearance-none
                  focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
              >
                <option value="" disabled selected>Select your role</option>
                <option value="practice-director">Practice Director / Principal</option>
                <option value="coaching-business-owner">Coaching Business Owner</option>
                <option value="independent-coach">Independent Coach</option>
                <option value="hr-ld-sponsor">HR / L&amp;D Sponsor</option>
                <option value="talent-development">Talent &amp; Development Lead</option>
                <option value="other">Other</option>
              </select>
            </div>

            <!-- Number of coachees -->
            <div>
              <label for="coachees" class="block text-sm font-medium text-ink mb-2">
                Approximate number of coachees
              </label>
              <select
                id="coachees"
                name="coachees"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink
                  transition-all duration-200 appearance-none
                  focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
              >
                <option value="" disabled selected>Select a range</option>
                <option value="1-10">1 &ndash; 10</option>
                <option value="11-50">11 &ndash; 50</option>
                <option value="51-200">51 &ndash; 200</option>
                <option value="200+">200+</option>
              </select>
            </div>

            <!-- How did you hear about us? -->
            <div>
              <label for="referral" class="block text-sm font-medium text-ink mb-2">
                How did you hear about us?
              </label>
              <input
                type="text"
                id="referral"
                name="referral"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm text-ink placeholder:text-muted/50
                  transition-all duration-200
                  focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50"
                placeholder="e.g. Google, LinkedIn, a colleague..."
              />
            </div>

            <!-- Submit -->
            <div>
              <button
                type="submit"
                class="btn-primary w-full sm:w-auto px-10 py-3.5 text-base"
              >
                Book My Demo
              </button>
            </div>

            <!-- GDPR note -->
            <p class="text-xs text-muted leading-relaxed">
              By submitting this form, you agree to our
              <a href="/privacy" class="underline hover:text-primary">Privacy Policy</a>.
              We'll only use your details to arrange your demo.
            </p>
          </form>
        </div>

        <!-- Right column - Info cards -->
        <div class="lg:col-span-2 space-y-6" data-reveal-stagger>

          <!-- What to expect card -->
          <div class="card-editorial p-6 md:p-8">
            <h3 class="text-lg font-semibold text-ink mb-4">What to expect</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>A personalised 30-minute walkthrough of the platform</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>Tailored to your role, whether you're a coach or an organisation</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>See how Mentric handles sessions, goals, analytics, and more</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>Ask anything, no pressure, no hard sell</span>
              </li>
            </ul>
          </div>

          <!-- Why Mentric card -->
          <div class="card-editorial p-6 md:p-8">
            <h3 class="text-lg font-semibold text-ink mb-4">Why practices choose Mentric</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>Purpose-built for coaching practices, not adapted from HR tools</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>White-label with your brand. Clients see you, not us</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>Programme-level evidence you can share with sponsors</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-foreground">
                <span class="w-1.5 h-1.5 rounded-full bg-primary mt-1.5 shrink-0"></span>
                <span>AI-powered insights that save hours every week</span>
              </li>
            </ul>
          </div>

          <!-- Quick contact card -->
          <div class="card-editorial p-6 md:p-8">
            <h3 class="text-lg font-semibold text-ink mb-4">Prefer to email?</h3>
            <p class="text-sm text-muted mb-3">
              Drop us a line and we'll get back to you within 24 hours.
            </p>
            <a href="mailto:hello@mentriccoaching.com" class="text-sm font-medium text-primary hover:text-glow transition-colors">
              hello@mentriccoaching.com
            </a>
          </div>

        </div>
      </div>
    </div>
  </section>

</PageLayout>
